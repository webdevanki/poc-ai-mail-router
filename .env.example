# Kopia domyslnych wartosci z docker-compose.yml / api/app/config.py.
# Docker Compose nie czyta tego pliku automatycznie (wartosci sa wpisane
# wprost w docker-compose.yml) - ten plik sluzy jako dokumentacja
# dostepnych zmiennych, np. do lokalnego uruchomienia bez Dockera.

OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=ai-router@example.com

LOG_LEVEL=INFO
